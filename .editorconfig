# https://editorconfig.org/
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 120

# The shell scripts predate this file and are consistently 4-space indented.
# shfmt (run via `make quality`) reads .editorconfig, so keep it matching reality.
[*.sh]
indent_size = 4
