# Secrets of the live-state API (server/).
#
#   cp .env.example .env      then fill in the real values
#
# .env is git-ignored and is the only place these belong. `make api` reads it locally, and
# `make deploy` copies it to the VPS as /opt/ennemi-web-api/.env (mode 0600), which the
# ennemi-web-api systemd unit loads, then restarts the service. So to change a secret: edit .env,
# then `make deploy`.
#
# Format: KEY=value, one per line. Do NOT quote values: quotes would be read as part of the
# value. # starts a comment only at the beginning of a line.

# Password of the /admin page.
ADMIN_PASSWORD=change-me

# Token the show app sends to switch the live state, at least 16 characters. Generate one with
#   openssl rand -hex 32
SHOW_TOKEN=change-me-to-a-long-random-token
